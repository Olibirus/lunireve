# ============================================================
# Lunireve — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ============================================================

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Supabase ----------
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # server-only, bypasses RLS

# Project settings → Database → Connection string
# DATABASE_URL     = "Transaction pooler" (port 6543) — used by the app runtime
# DIRECT_DATABASE_URL = "Direct connection" (port 5432) — used for migrations
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgres://postgres:password@db.xxxx.supabase.co:5432/postgres

# ---------- AI providers ----------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=

# Which provider powers each flavor of generation. Swap without touching code.
# text: anthropic | openai
TEXT_PROVIDER=anthropic
# image: openai | replicate
IMAGE_PROVIDER_LIBRARY=openai
IMAGE_PROVIDER_PERSONALIZED=openai
# audio: openai | elevenlabs
AUDIO_PROVIDER_LIBRARY=openai
AUDIO_PROVIDER_PERSONALIZED=elevenlabs

# ---------- Payments (Stripe) ----------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------- Email (Brevo) ----------
BREVO_API_KEY=

# ---------- Print on demand (Phase 3) ----------
GELATO_API_KEY=
